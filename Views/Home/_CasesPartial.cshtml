        <div class="col"></div>
        <div class="col"><strong>Japanese</strong></div>
        <div class="col"></div>
    </div>
    <div class="row row-separator">
        <div class="col">Nominative</div>
        <div class="col grammar-verbs-ideograms small">이/가/는/은</div>
        <div class="col">i / ga / (n)ŭn</div>
        <div class="col grammar-verbs-ideograms">が/は</div>
        <div class="col">ga / wa</div>
    </div>
    <div class="row row-separator">
        <div class="col">Accusative</div>
        <div class="col grammar-verbs-ideograms small">를/을</div>
        <div class="col">(r)ŭl</div>
        <div class="col grammar-verbs-ideograms">を</div>
        <div class="col">o</div>
    </div>
    <div class="row row-separator">
        <div class="col">Genitive</div>
        <div class="col grammar-verbs-ideograms small">의</div>
        <div class="col">ŭi</div>
        <div class="col grammar-verbs-ideograms">の</div>
        <div class="col">no</div>
    </div>
    <div class="row row-separator">
        <div class="col">Dative</div>
        <div class="col grammar-verbs-ideograms small">에/에게</div>
        <div class="col">e / ege</div>
        <div class="col grammar-verbs-ideograms">に</div>
        <div class="col">ni</div>
    </div>
    <div class="row row-separator">
        <div class="col">Locative</div>
        <div class="col grammar-verbs-ideograms small">에서/에게서</div>
        <div class="col">esŏ / egesŏ</div>
        <div class="col grammar-verbs-ideograms">に/で</div>
        <div class="col">ni (state) / de (action)</div>
    </div>
    <div class="row row-separator">
        <div class="col">Lative</div>
        <div class="col grammar-verbs-ideograms small">에</div>
        <div class="col">e</div>
        <div class="col grammar-verbs-ideograms">へ</div>
        <div class="col">e</div>
    </div>
    <div class="row row-separator">
        <div class="col">Ablative</div>
        <div class="col grammar-verbs-ideograms small">에서</div>
        <div class="col">esŏ</div>
        <div class="col grammar-verbs-ideograms">から</div>
        <div class="col">kara</div>
    </div>
    <div class="row row-separator">
        <div class="col">Instrumental</div>
