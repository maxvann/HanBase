        <div class="col">Comitative</div>
        <div class="col grammar-verbs-ideograms small">하고</div>
        <div class="col">hago</div>
        <div class="col grammar-verbs-ideograms">と</div>
        <div class="col">to</div>
    </div>
    <div class="row row-separator">
        <div class="col">Vocative</div>
        <div class="col grammar-verbs-ideograms small">야/아</div>
