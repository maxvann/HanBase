<div class="row grammar-cell">
    <div><em>Command Constructs</em></div>
    <div><strong>You may, you are allowed to</strong></div>
    <div class="col">verb-te mo ii desu (ka)</div>
    <div><strong>You are not allowed to</strong></div>
    <div class="col">verb-te wa ikemasen (ikenai)</div>
    <div><strong>Please do</strong></div>
    <div class="col">verb-te kudasai</div>
    <div><strong>I want you to</strong></div>
    <div class="col">verb-te hoshii desu</div>
    <div><strong>You should</strong></div>
    <div class="col">verb-ta hō ga ii desu</div>
    <div><strong>You shouldn't</strong></div>
    <div class="col">verb-nai hō ga ii desu</div>
    <div><strong>Please don't</strong></div>
    <div class="col">verb-nai de kudasai</div>
    <div><strong>I want you not to</strong></div>
    <div class="col">verb-nai de hoshii desu</div>
    <div><strong>You must</strong></div>
    <div class="col">verb-(nai) nakareba narimasen</div>
    <div><strong>You don't have to</strong></div>
    <div class="col">verb-(nai) nakutemo ii desu</div>
</div>
