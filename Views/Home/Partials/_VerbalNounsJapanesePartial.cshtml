<div class="row grammar-cell">
    <div><strong>Verb-u</strong></div>
    <div>verb stem-<strong>u</strong> => verb stem-<strong>i</strong></div>
    <div class="grammar-verbs-ideograms">飲むます => 飲み</div>
    <div>nomimasu => nomi</div>
    <div>to drink => drinking</div>
</div>
<div class="row grammar-cell">
    <div><strong>Verb-ru</strong></div>
    <div>verb stem-<strong>ru</strong> => verb stem</div>
    <div class="grammar-verbs-ideograms">食べます => 食べ</div>
    <div>tabemasu => tabe</div>
    <div>to eat => eating</div>
</div>
