<div class="row grammar-cell">
    <div><em>subject + <strong>auxiliary</strong> + verb + object</em></div>
    <div><strong>Would like to</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">想</div>
        <div class="col">xiǎng</div>
    </div>
    <div><strong>Like to</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">喜欢</div>
        <div class="col">xǐhuan</div>
    </div>
    <div><strong>Want to</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">要</div>
        <div class="col">yào</div>
    </div>
    <div><strong>Ought to</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">应该</div>
        <div class="col">yīnggāi</div>
    </div>
    <div><strong>Must</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">得</div>
        <div class="col">děi</div>
    </div>
    <div><strong>Must (as a necessity)</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">必得</div>
        <div class="col">bìděi</div>
    </div>
    <div><strong>Can, able to</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">能</div>
        <div class="col">néng</div>
    </div>
    <div><strong>May</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">会</div>
        <div class="col">huì</div>
    </div>
    <div><strong>Can</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">可以</div>
        <div class="col">kěyǐ</div>
    </div>
    <div><strong>Willing to</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">愿意</div>
        <div class="col">yuànyì</div>
    </div>
    <div><strong>Able to</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">肯</div>
        <div class="col">kěn</div>
    </div>
