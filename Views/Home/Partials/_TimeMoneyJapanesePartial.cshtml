<div><strong>Time</strong></div>
<div class="row grammar-cell">
    <table class="grammar-table mb-2 mt-2">
        <thead>
            <tr>
                <th>Time</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Interval</td>
                <td class="grammar-verbs-ideograms">間</td>
                <td>kan</td>
            </tr>
            <tr>
                <td>Hours</td>
                <td class="grammar-verbs-ideograms">時間</td>
                <td>jikan</td>
            </tr>
            <tr>
                <td>Weeks</td>
                <td class="grammar-verbs-ideograms">週間</td>
                <td>shūkan</td>
            </tr>
            <tr>
                <td>Months</td>
                <td class="grammar-verbs-ideograms">ヶ月</td>
                <td>kagetsu</td>
            </tr>
            <tr>
                <td>Years</td>
                <td class="grammar-verbs-ideograms">年間</td>
                <td>nenkan</td>
            </tr>
        </tbody>
    </table>
    <div><strong>Hours / o'clock</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">時</div>
        <div class="col">number + ji</div>
    </div>
    <div><strong>Minutes</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">分</div>
        <div class="col">number + fun</div>
    </div>
    <div><strong>Morning (a.m.)</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">午前</div>
        <div class="col">gozen + time</div>
    </div>
    <div><strong>Afternoon (p.m.)</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">午後</div>
        <div class="col">gogo + time</div>
    </div>
    <div><strong>What time is it?</strong></div>
    <div class="grammar-verbs-ideograms">何時ですか?</div>
    <div>nanji desu ka?</div>
    <div><strong>at 6 o'clock</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">六時に</div>
        <div class="col">roku-ji ni</div>
    </div>
    <div><strong>1:05</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">一時五分</div>
        <div class="col">ichi-ji go-fun</div>
    </div>
    <div><strong>1:30</strong></div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">一時三十分</div>
        <div class="col">ichi-ji sanjūp-pun</div>
    </div>
    <div class="row">
        <div class="col grammar-verbs-ideograms">一時半</div>
        <div class="col">ichi-ji han</div>
    </div>
    <div><strong>1:35</strong></div>
    <div class="grammar-verbs-ideograms">一時三十五分</div>
    <div>ichi-ji sanjūgo-fun</div>
    <div class="grammar-verbs-ideograms">二時二十五分前</div>
    <div>ni-ji nijūgo-fun mae</div>
    <div><strong>1:30 a.m.</strong></div>
    <div class="grammar-verbs-ideograms">午前一時半</div>
    <div>gozen ichi-ji han</div>
    <div><strong>4:35 p.m. on Tuesday</strong></div>
    <div class="grammar-verbs-ideograms">火曜日の午後4時35分</div>
    <div>kayōbi no gogo yon-ji sanshi-go-fun</div>
</div>
