<div class="row grammar-cell">
    <div><strong>Nominal (adjective to noun)</strong></div>
    <div>adjective + <strong>de</strong></div>
    <div class="grammar-verbs-ideograms">快<span class="grammar-verbs-highlight">的</span></div>
    <div class="col">kuài de</div>
    <div class="col">The quick one</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adverb (adjective to adverb)</strong></div>
    <div>adjective + <strong>de</strong></div>
    <div class="grammar-verbs-ideograms">快<span class="grammar-verbs-highlight">地</span></div>
    <div class="col">kuài de</div>
    <div class="col">Quickly</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (de)</strong></div>
    <div>adjective-<strong>de</strong> + noun</div>
    <div class="grammar-verbs-ideograms">黑<span class="grammar-verbs-highlight">的</span>猫</div>
    <div>hēi de māo</div>
    <div>The black cat (the cat that is black)</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (hěn)</strong></div>
    <div>noun + <strong>hěn</strong> + adjective</div>
    <div class="grammar-verbs-ideograms">猫<span class="grammar-verbs-highlight">很</span>黑</div>
    <div>māo hěn hēi</div>
    <div>The cat is black</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (shì)</strong></div>
    <div>noun + <strong>shì</strong> + adjective-<strong>de</strong></div>
    <div class="grammar-verbs-ideograms">猫<span class="grammar-verbs-highlight">是</span>黑<span class="grammar-verbs-highlight">的</span></div>
    <div>māo shì hēi de</div>
    <div>The cat is the black one</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (construct)</strong></div>
    <div>adjective-<strong>de</strong> + noun + verb + noun</div>
    <div class="grammar-verbs-ideograms">黑<span class="grammar-verbs-highlight">的</span>猫喝牛奶</div>
    <div>hēi de māo hē niúnǎi</div>
    <div>The black cat drinks the milk</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (construct)</strong></div>
    <div>noun-de + noun + <strong>shì</strong> + adjective-<strong>de</strong></div>
    <div class="grammar-verbs-ideograms">猫<span class="grammar-verbs-highlight">的</span>牛奶<span class="grammar-verbs-highlight">是</span>白色<span class="grammar-verbs-highlight">的</span></div>
    <div>māo de niúnǎi shì báisè de</div>
    <div>The cat's milk is white</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (construct)</strong></div>
    <div>noun-<strong>de</strong> + adjective-<strong>de</strong> + noun</div>
    <div class="grammar-verbs-ideograms">猫<span class="grammar-verbs-highlight">的</span>白色<span class="grammar-verbs-highlight">的</span>牛奶</div>
    <div>māo de báisè de niúnǎi</div>
    <div>The white milk of the cat</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (construct)</strong></div>
    <div>noun-<strong>de</strong> + adjective-<strong>de</strong> + noun + <strong>shì</strong> + adjective</div>
    <div class="grammar-verbs-ideograms">猫<span class="grammar-verbs-highlight">的</span>白色<span class="grammar-verbs-highlight">的</span>牛奶<span class="grammar-verbs-highlight">是</span>冷</div>
    <div>māo de báisè de niúnǎi shì lěng</div>
    <div>The white milk of the cat is cold</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (very)</strong></div>
    <div>adjective + <strong>dehěn</strong></div>
    <div class="grammar-verbs-ideograms">多<span class="grammar-verbs-highlight">得很</span></div>
    <div class="col">duō dehěn</div>
    <div class="col">Very many</div>
</div>
<div class="row grammar-cell">
    <div><strong>Adjective (verb to adjective)</strong></div>
    <div><strong>kě</strong> + verb</div>
    <div class="grammar-verbs-ideograms"><span class="grammar-verbs-highlight">可</span>爱</div>
    <div class="col">kě'ài</div>
    <div class="col">lovely, loveable</div>
    <div class="grammar-verbs-ideograms"><span class="grammar-verbs-highlight">可</span>怜</div>
    <div class="col">kělián</div>
    <div class="col">pitiful, pitiable</div>
    <div class="grammar-verbs-ideograms"><span class="grammar-verbs-highlight">可</span>惜</div>
    <div class="col">kěxī</div>
    <div class="col">pity</div>
    <div class="grammar-verbs-ideograms"><span class="grammar-verbs-highlight">可</span>靠</div>
    <div class="col">kěkào</div>
    <div class="col">reliable</div>
    <div class="grammar-verbs-ideograms"><span class="grammar-verbs-highlight">可</span>怕</div>
    <div class="col">kěpà</div>
    <div class="col">terrifying</div>
    <div class="grammar-verbs-ideograms"><span class="grammar-verbs-highlight">可</span>笑</div>
    <div class="col">kěxiào</div>
    <div class="col">laughable</div>
    <div class="grammar-verbs-ideograms"><span class="grammar-verbs-highlight">可</span>能</div>
    <div class="col">kěnéng</div>
    <div class="col">possible, probable</div>
</div>
