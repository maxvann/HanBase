@{
    ViewData["Title"] = "Grammar";
}

<h2>Grammar</h2>

<div class="accordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar1">
                Chinese Tonal System
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar2">
                Nouns
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar3">
                Pronouns
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar4">
                Adjectives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar5">
                Comparatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar6">
                Superlatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar7">
                Adverbs
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar8">
                Demonstratives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar9">
                Interrogatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button">
                Verbs
            </a>
        </h2>
        <div class="accordion-collapse">
            <div class="accordion-body">
                <h4 class="section-header" x-on:click="showVerbsPresent = !showVerbsPresent">
                    Present Tense
                    <span class="icon caret-down-fill" x-show="showVerbsPresent"></span>
                    <span class="icon caret-up-fill" x-show="!showVerbsPresent" x-cloak></span>
                </h4>
                <div x-show="showVerbsPresent" x-transition>
                    <partial name="Partials/_PresentSimpleActivePartial" />
                    <partial name="Partials/_PresentSimplePassivePartial" />
                    <partial name="Partials/_PresentProgressiveActivePartial" />
                    <partial name="Partials/_PresentProgressivePassivePartial" />
                    <partial name="Partials/_PresentPerfectActivePartial" />
                    <partial name="Partials/_PresentPerfectPassivePartial" />
                    <partial name="Partials/_PresentPerfectProgressiveActivePartial" />
                    <partial name="Partials/_PresentPerfectProgressivePassivePartial" />
                </div>
                <h4 class="section-header mt-4" x-on:click="showVerbsPast = !showVerbsPast">
                    Past Tense
                    <span class="icon caret-down-fill" x-show="showVerbsPast"></span>
                    <span class="icon caret-up-fill" x-show="!showVerbsPast" x-cloak></span>
                </h4>
                <div x-show="showVerbsPast" x-transition>
                    <partial name="Partials/_PastSimpleActivePartial" />
                    <partial name="Partials/_PastSimplePassivePartial" />
                    <partial name="Partials/_PastProgressiveActivePartial" />
                    <partial name="Partials/_PastProgressivePassivePartial" />
                    <partial name="Partials/_PastPerfectActivePartial" />
                    <partial name="Partials/_PastPerfectPassivePartial" />
                    <partial name="Partials/_PastPerfectProgressiveActivePartial" />
                    <partial name="Partials/_PastPerfectProgressivePassivePartial" />
                </div>
                <h4 class="section-header mt-4" x-on:click="showVerbsFuture = !showVerbsFuture">
                    Future Tense
                    <span class="icon caret-down-fill" x-show="showVerbsFuture"></span>
                    <span class="icon caret-up-fill" x-show="!showVerbsFuture" x-cloak></span>
                </h4>
                <div x-show="showVerbsFuture" x-transition>
                    <partial name="Partials/_FutureSimpleActivePartial" />
                    <partial name="Partials/_FutureSimplePassivePartial" />
                    <partial name="Partials/_FutureProgressiveActivePartial" />
                    <partial name="Partials/_FutureProgressivePassivePartial" />
                    <partial name="Partials/_FuturePerfectActivePartial" />
                    <partial name="Partials/_FuturePerfectPassivePartial" />
                    <partial name="Partials/_FuturePerfectProgressiveActivePartial" />
                    <partial name="Partials/_FuturePerfectProgressivePassivePartial" />
                </div>
            </div>
        </div>
    </div>
</div>
