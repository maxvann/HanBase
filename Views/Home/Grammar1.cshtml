@{
    ViewData["Title"] = "Grammar";
}

<h2>Grammar</h2>

<div class="accordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button grammar-accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_section" aria-expanded="true" aria-controls="collapse_section">
                Chinese Tonal System
            </button>
        </h2>
        <div id="collapse_section" class="accordion-collapse show">
            <div class="accordion-body">
                <partial name="Partials/_ChineseTonesPartial" />
            </div>
            <div class="transform-container">
                <div class="me-2"><strong>JyutPing to Yale</strong></div>
                <input class="search-box me-2" type="text" name="search" x-model="transform" placeholder="e.g. ngo5 ji5 ging1 => ngóℏ yíℏ gìng" />
                <button class="search" type="button" x-on:click="transformText();">
                    <div class="transform-icon-container">
                        <div class="icon search"></div>
                    </div>
                </button>
            </div>
        </div>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar2">
                Nouns
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar3">
                Pronouns
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar4">
                Adjectives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar5">
                Comparatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar6">
                Superlatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar7">
                Adverbs
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar8">
                Demonstratives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar9">
                Interrogatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar10">
                Verbs
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar11">
                Verbal Nouns
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar12">
                Verb Endings
            </a>
        </h2>
    </div>
</div>
