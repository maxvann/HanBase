@{
    ViewData["Title"] = "Grammar";
}

<h2>Grammar</h2>

<div class="accordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar1">
                Chinese Tonal System
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button">
                Nouns
            </a>
        </h2>
        <div class="accordion-collapse">
            <div class="accordion-body">
                <h4>Word Order</h4>
                <div class="row">
                    <div class="col"><strong>Mandarin</strong></div>
                    <div class="col"><strong>Cantonese</strong></div>
                    <div class="col"><strong>Korean</strong></div>
                    <div class="col"><strong>Japanese</strong></div>
                </div>
                <div class="row">
                    <div class="col">Subject – Verb – Object (S-V-O)</div>
                    <div class="col">Subject – Verb – Object (S-V-O)</div>
                    <div class="col">Subject – Object – Verb (S-O-V)</div>
                    <div class="col">Subject – Object – Verb (S-O-V)</div>
                </div>
                <h4 class="mt-4">Particles</h4>
                <div class="row">
                    <div class="col"><strong>Mandarin</strong></div>
                    <div class="col"><strong>Cantonese</strong></div>
                    <div class="col"><strong>Korean</strong></div>
                    <div class="col"><strong>Japanese</strong></div>
                </div>
                <div class="row">
                    <div class="col"><partial name="Partials/_ParticlesMandarinPartial" /></div>
                    <div class="col"><partial name="Partials/_ParticlesCantonesePartial" /></div>
                    <div class="col"><partial name="Partials/_ParticlesKoreanPartial" /></div>
                    <div class="col"><partial name="Partials/_ParticlesJapanesePartial" /></div>
                </div>
                <h4 class="mt-4">Cases</h4>
                <partial name="Partials/_CasesPartial" />
                <h4 class="mt-4">Examples</h4>
                <partial name="Partials/_ParticlesExamplesPartial" />
            </div>
        </div>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar3">
                Pronouns
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar4">
                Adjectives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar5">
                Comparatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar6">
                Superlatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar7">
                Adverbs
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar8">
                Demonstratives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar9">
                Interrogatives
            </a>
        </h2>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <a class="accordion-button grammar-accordion-button collapsed" asp-area="" asp-controller="Home" asp-action="Grammar10">
                Verbs
            </a>
        </h2>
    </div>
</div>
