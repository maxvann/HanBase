@using HanBase.Constants
@using HanBase.Extensions

@{
    ViewData["Title"] = "Charts";
}

<div class="charts-container">
    <h4>Korean Hangul</h4>

    <div><em>Click a cell to hear how the Hangul is pronounced</em></div>

    <div class="glyphs-body korean mb-4">
        @{
            var glyphNumber = 0;
            var hangulSounds = Charts.GetHangulSound();
            var hangulAudio = Charts.GetHangulAudio();
        }

        @foreach (var glyph in Charts.GetHangul())
        {
            <div class="glyph-container glyph glyph-hover" onclick="playHangul('@hangulAudio[glyphNumber]');">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(hangulSounds[glyphNumber++])</div>
            </div>
        }
    </div>

    <h4>Korean Morphology</h4>

    <partial name="Partials/_KoreanMorphologyPartial" />

    <h4 class="mt-4">Japanese Hiragana</h4>

    <div class="glyphs-body japanese">
        @{
            glyphNumber = 0;
            var hiraganaSounds = Charts.GetHiraganaSound();
        }

        @foreach (var glyph in Charts.GetHiragana())
        {
            <div class="glyph-container glyph">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(hiraganaSounds[glyphNumber++])</div>
            </div>
        }
    </div>

    <div class="glyphs-body japanese-ext mt-4">
        @{
            glyphNumber = 0;
            var hiraganaExtSounds = Charts.GetHiraganaExtSound();
        }

        @foreach (var glyph in Charts.GetHiraganaExt())
        {
            <div class="glyph-container glyph">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(hiraganaExtSounds[glyphNumber++])</div>
            </div>
        }
    </div>

    <div class="glyphs-body japanese-combo mt-4">
        @{
            glyphNumber = 0;
            var hiraganaComboSounds = Charts.GetHiraganaComboSound();
        }

        @foreach (var glyph in Charts.GetHiraganaCombo())
        {
            <div class="glyph-container glyph">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(hiraganaComboSounds[glyphNumber++])</div>
            </div>
        }
    </div>

    <div class="glyphs-body japanese-combo-ext mt-4">
        @{
            glyphNumber = 0;
            var hiraganaComboExtSounds = Charts.GetHiraganaComboExtSound();
        }

        @foreach (var glyph in Charts.GetHiraganaComboExt())
        {
            <div class="glyph-container glyph">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(hiraganaComboExtSounds[glyphNumber++])</div>
            </div>
        }
    </div>

    <div class="row chart-modifier mt-4">
        <div class="col">
            <div><strong>Lengthening Vowel</strong></div>
            <div>a, i, u, e, o</div>
            <div class="grammar-verbs-ideograms">あ,い,う,え,お</div>
            <div><em>Example</em></div>
            <div class="grammar-verbs-ideograms">と<span class="grammar-verbs-highlight">う</span>きょ<span class="grammar-verbs-highlight">う</span></div>
            <div>Tōkyō</div>
        </div>
        <div class="col">
            <div><strong>Doubling Consonant</strong></div>
            <div>small tsu</div>
            <div class="grammar-verbs-ideograms">っ</div>
            <div><em>Example</em></div>
            <div class="grammar-verbs-ideograms">き<span class="grammar-verbs-highlight">っ</span>て</div>
            <div>kitte</div>
        </div>
    </div>

    <h4 class="mt-4">Japanese Katakana</h4>

    <div class="glyphs-body japanese">
        @{
            glyphNumber = 0;
            var katakanaSounds = Charts.GetKatakanaSound();
        }

        @foreach (var glyph in Charts.GetKatakana())
        {
            <div class="glyph-container glyph">
