        }

        @foreach (var glyph in Charts.GetKatakanaExt())
        {
            <div class="glyph-container glyph">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(katakanaExtSounds[glyphNumber++])</div>
            </div>
        }
    </div>

    <div class="glyphs-body japanese-combo mt-4">
        @{
            glyphNumber = 0;
            var katakanaComboSounds = Charts.GetKatakanaComboSound();
        }

        @foreach (var glyph in Charts.GetKatakanaCombo())
        {
            <div class="glyph-container glyph">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(katakanaComboSounds[glyphNumber++])</div>
            </div>
        }
    </div>

    <div class="glyphs-body japanese-combo-ext mt-4">
        @{
            glyphNumber = 0;
            var katakanaComboExtSounds = Charts.GetKatakanaComboExtSound();
        }

        @foreach (var glyph in Charts.GetKatakanaComboExt())
        {
            <div class="glyph-container glyph">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(katakanaComboExtSounds[glyphNumber++])</div>
            </div>
        }
    </div>

    <div class="row chart-modifier mt-4">
        <div class="col">
            <div><strong>Lengthening Mark</strong></div>
            <div class="grammar-verbs-ideograms">ー</div>
            <div><em>Example</em></div>
            <div class="grammar-verbs-ideograms">コ<span class="grammar-verbs-highlight">ー</span>ヒ<span class="grammar-verbs-highlight">ー</span></div>
            <div>kōhī</div>
        </div>
        <div class="col">
            <div><strong>Doubling Consonant</strong></div>
            <div>small tsu</div>
            <div class="grammar-verbs-ideograms">ッ</div>
            <div><em>Example</em></div>
            <div class="grammar-verbs-ideograms">キ<span class="grammar-verbs-highlight">ッ</span>テ</div>
            <div>kitte</div>
        </div>
    </div>

    <h4 class="mt-4">Chinese Bopomofo (Zhùyīn Fúhào 注音符号 / ㄓㄨˋ ㄧㄣ ㄈㄨˊ ㄏㄠˋ)</h4>

    <div><em>Click a cell to hear how the Chinese is pronounced</em></div>

    <div class="glyphs-body chinese">
        @{
            glyphNumber = 0;
            var bopomofoSounds = Charts.GetBopomofoSound();
            var pinyinAudio = Charts.GetBopomofoAudio();
        }

        @foreach (var glyph in Charts.GetBopomofo())
        {
            <div class="glyph-container glyph glyph-hover" onclick="playPinyin('@pinyinAudio[glyphNumber]');">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(bopomofoSounds[glyphNumber++])</div>
