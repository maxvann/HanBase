@using HanBase.Constants
@using HanBase.Extensions

@{
    ViewData["Title"] = "Charts";
}

<div class="charts-container">
    <h4>Korean Hangul</h4>

    <div class="glyphs-body korean">
        @{
            var glyphNumber = 0;
            var hangulSounds = Charts.GetHangulSound();
        }

        @foreach (var glyph in Charts.GetHangul())
        {
            <div class="glyph-container glyph">
                <div class="glyph-mark">@glyph.ToUnicode()</div>
                <div class="glyph-sound">@(hangulSounds[glyphNumber++])</div>
            </div>

        }
    </div>

    <h4 class="mt-4">Japanese Hiragana</h4>

    <div class="glyphs-body japanese">
        @{
            glyphNumber = 0;
            var hiraganaSounds = Charts.GetHiraganaSound();
